#!/bin/sh
### BEGIN INIT INFO
# Provides:          guppyscreen
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Description:       Guppy Screen - Touch UI for Klipper
### END INIT INFO

GUPPYSCREEN_EXEC=/usr/bin/guppyscreen
GUPPYCONFIG=/etc/klipper/config/guppyconfig.json
PIDFILE=/var/run/gui.pid

case "$1" in
    start)
        echo "Starting guppyscreen..."
        # Disable console cursor blinking
        if [ -e /sys/class/graphics/fbcon/cursor_blink ]; then
            echo 0 > /sys/class/graphics/fbcon/cursor_blink
        fi

        # Discover klipper-host's IP as the default gateway and patch guppyconfig.json.
        # The overlayfs upper layer on /data makes /etc writable, so this persists
        # across reboots without touching the squashfs. Phase 5 (nebula.toml) will
        # generate the full config at boot instead.
        GW=""
        for i in $(seq 1 15); do
            GW=$(ip route show default 2>/dev/null | awk '{print $3; exit}')
            [ -n "$GW" ] && break
            sleep 2
        done
        if [ -n "$GW" ]; then
            sed -i "s/\"moonraker_host\": \"[^\"]*\"/\"moonraker_host\": \"$GW\"/" \
                "$GUPPYCONFIG"
        else
            echo "Warning: no default route found; guppyscreen will use cached Moonraker host"
        fi

        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$GUPPYSCREEN_EXEC"
        ;;
    stop)
        echo "Stopping guppyscreen..."
        start-stop-daemon -K -p "$PIDFILE" -R 10
        rm -f "$PIDFILE"
        ;;
    restart|force-reload)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "guppyscreen is running (PID $(cat "$PIDFILE"))"
        else
            echo "guppyscreen is not running"
            return 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?
