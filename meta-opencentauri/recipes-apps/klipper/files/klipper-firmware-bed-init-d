#!/bin/sh
### BEGIN INIT INFO
# Provides:          klipper-firmware-bed
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Bed MCU power control
### END INIT INFO

# GPIO 201: bed MCU power (switched 5V on JST pin 3 — high = on, low = off/reset)
# Works for both STM32F401 (original) and RP2040 (custom) bed MCU variants.
GPIO="201"

gpio_set() {
    echo $GPIO > /sys/class/gpio/export 2>/dev/null || true
    echo out > /sys/class/gpio/gpio$GPIO/direction
    echo "$1" > /sys/class/gpio/gpio$GPIO/value
    echo $GPIO > /sys/class/gpio/unexport 2>/dev/null || true
}

case "$1" in
    start)
        echo "Powering on bed MCU..."
        gpio_set 1
        sleep 1
        echo "Bed MCU ready."
        # Firmware flashing is managed by klipper-host via SSH + flashtool
        ;;
    stop)
        echo "Powering off bed MCU..."
        gpio_set 0
        ;;
    restart|force-reload)
        $0 stop
        sleep 2
        $0 start
        ;;
    status)
        echo $GPIO > /sys/class/gpio/export 2>/dev/null || true
        VAL=$(cat /sys/class/gpio/gpio$GPIO/value 2>/dev/null || echo unknown)
        echo $GPIO > /sys/class/gpio/unexport 2>/dev/null || true
        if [ "$VAL" = "1" ]; then
            echo "bed MCU: powered on"
        else
            echo "bed MCU: powered off or unknown"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
