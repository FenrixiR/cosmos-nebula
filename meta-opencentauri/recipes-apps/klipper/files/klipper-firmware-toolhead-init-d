#!/bin/sh
### BEGIN INIT INFO
# Provides:          klipper-firmware-toolhead
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Toolhead MCU power control
### END INIT INFO

# GPIO 140: toolhead MCU reset line (high = running, low = held in reset)
GPIO="140"
SERIALPORT="/dev/serial/by-path/platform-4101400.usb-usb-0:1:1.0"

gpio_set() {
    echo $GPIO > /sys/class/gpio/export 2>/dev/null || true
    echo out > /sys/class/gpio/gpio$GPIO/direction
    echo "$1" > /sys/class/gpio/gpio$GPIO/value
    echo $GPIO > /sys/class/gpio/unexport 2>/dev/null || true
}

case "$1" in
    start)
        echo "Powering on toolhead MCU..."
        gpio_set 1
        sleep 3
        echo "Toolhead MCU ready."
        # Firmware flashing is managed by klipper-host via SSH + flashtool
        ;;
    stop)
        echo "Powering off toolhead MCU..."
        gpio_set 0
        ;;
    restart|force-reload)
        $0 stop
        sleep 2
        $0 start
        ;;
    status)
        echo $GPIO > /sys/class/gpio/export 2>/dev/null || true
        VAL=$(cat /sys/class/gpio/gpio$GPIO/value 2>/dev/null || echo unknown)
        echo $GPIO > /sys/class/gpio/unexport 2>/dev/null || true
        if [ "$VAL" = "1" ]; then
            echo "toolhead MCU: powered on"
        else
            echo "toolhead MCU: powered off or unknown"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
