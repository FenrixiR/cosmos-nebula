#!/bin/sh
### BEGIN INIT INFO
# Provides:          nebula-init
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Cosmos-Nebula boot-time config generation from nebula.toml
### END INIT INFO

NEBULA_CONF="/etc/nebula.toml"

# Parse a value from nebula.toml.
# Usage: get_value <section> <key>
# Handles: key = "quoted string"  and  key = bare_value
# Ignores lines starting with # and blank lines.
get_value() {
    local section="$1" key="$2"
    awk -v section="$section" -v key="$key" '
        /^\[/ {
            cur = $0
            gsub(/[\[\] \t]/, "", cur)
        }
        cur == section && /^[^#\[]/ {
            n = index($0, "=")
            if (n == 0) next
            k = substr($0, 1, n - 1)
            v = substr($0, n + 1)
            gsub(/[ \t]/, "", k)
            gsub(/^[ \t]*/, "", v)
            gsub(/[ \t]*(#.*)?$/, "", v)
            gsub(/^"/, "", v)
            gsub(/"$/, "", v)
            if (k == key) { print v; exit }
        }
    ' "$NEBULA_CONF"
}

generate_configs() {
    if [ ! -f "$NEBULA_CONF" ]; then
        echo "nebula-init: $NEBULA_CONF not found — skipping config generation" >&2
        return 0
    fi

    WIFI_SSID=$(get_value wifi ssid)
    WIFI_PASS=$(get_value wifi password)
    MAIN_PORT=$(get_value bridge mainboard_port)
    BED_PORT=$(get_value bridge bed_port)
    TOOL_PORT=$(get_value bridge toolhead_port)
    NTP_SERVER=$(get_value ntp server)

    # Apply defaults for missing bridge/ntp values
    MAIN_PORT=${MAIN_PORT:-7001}
    BED_PORT=${BED_PORT:-7002}
    TOOL_PORT=${TOOL_PORT:-7003}
    NTP_SERVER=${NTP_SERVER:-192.168.4.1}

    # --- wpa_supplicant.conf ---
    if [ -n "$WIFI_SSID" ] && [ -n "$WIFI_PASS" ]; then
        cat > /etc/wpa_supplicant.conf <<EOF
ctrl_interface=/run/wpa_supplicant
update_config=0

network={
    ssid="$WIFI_SSID"
    psk="$WIFI_PASS"
    key_mgmt=WPA-PSK
}
EOF
        echo "nebula-init: /etc/wpa_supplicant.conf generated (ssid=$WIFI_SSID)"
    else
        echo "nebula-init: wifi.ssid or wifi.password missing — skipping wpa_supplicant.conf" >&2
    fi

    # --- tcp-serial-bridge.conf ---
    cat > /etc/tcp-serial-bridge.conf <<EOF
# Generated by nebula-init from $NEBULA_CONF — edit nebula.toml, not this file

[[bridge]]
device = "/dev/ttyRPMSG0"
port   = $MAIN_PORT

[[bridge]]
device = "/dev/ttyS4"
port   = $BED_PORT
baud   = 250000

[[bridge]]
device = "/dev/serial/by-path/platform-4101400.usb-usb-0:1:1.0"
port   = $TOOL_PORT
baud   = 250000
EOF
    echo "nebula-init: /etc/tcp-serial-bridge.conf generated (ports: $MAIN_PORT/$BED_PORT/$TOOL_PORT)"

    # --- chrony.conf ---
    cat > /etc/chrony.conf <<EOF
# Generated by nebula-init from $NEBULA_CONF — edit nebula.toml, not this file
server $NTP_SERVER iburst prefer
driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync
EOF
    echo "nebula-init: /etc/chrony.conf generated (server=$NTP_SERVER)"
}

case "$1" in
    start)
        generate_configs
        ;;
    stop)
        # Generated files persist on /data (overlayfs) — no cleanup
        ;;
    restart|force-reload)
        $0 start
        ;;
    status)
        if [ -f "$NEBULA_CONF" ]; then
            echo "nebula-init: $NEBULA_CONF present"
        else
            echo "nebula-init: $NEBULA_CONF missing"
            return 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
