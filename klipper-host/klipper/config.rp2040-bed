# Klipper MCU build config for RP2040-Zero custom bed MCU
# UART on GP0 (TX) / GP1 (RX), 250000 baud, 16KiB Katapult offset
#
# Build with:
#   cd ~/kalico
#   make KCONFIG_CONFIG=~/cosmos-nebula/klipper-host/klipper/config.rp2040-bed
#
# ⚠ Verify variable names against `make menuconfig` with:
#   Micro-controller: Raspberry Pi RP2040
#   Bootloader offset: 16KiB
#   Communication: Serial (UART)
#   UART: UART0 TX GP0 / RX GP1
#   Baud: 250000

CONFIG_LOW_LEVEL_OPTIONS=y
# CONFIG_MACH_AVR is not set
# CONFIG_MACH_ATSAM is not set
# CONFIG_MACH_ATSAMD is not set
# CONFIG_MACH_LPC176X is not set
# CONFIG_MACH_STM32 is not set
# CONFIG_MACH_HC32F460 is not set
CONFIG_MACH_RPXXXX=y
# CONFIG_MACH_PRU is not set
# CONFIG_MACH_AR100 is not set
# CONFIG_MACH_HIFI4 is not set
# CONFIG_MACH_LINUX is not set
# CONFIG_MACH_SIMU is not set
CONFIG_BOARD_DIRECTORY="rp2040"
CONFIG_MCU="rp2040"
CONFIG_CLOCK_FREQ=125000000
CONFIG_FLASH_SIZE=0x200000
CONFIG_FLASH_BOOT_ADDRESS=0x10000000
CONFIG_RAM_START=0x20000000
CONFIG_RAM_SIZE=0x42000
CONFIG_STACK_SIZE=512
# 16KiB Katapult bootloader offset
CONFIG_FLASH_APPLICATION_ADDRESS=0x10004000
CONFIG_RPXXXX_SELECT=y
CONFIG_MACH_RP2040=y
# Serial UART (not USB, not CAN)
# CONFIG_USBSERIAL is not set
# CONFIG_CANSERIAL is not set
CONFIG_SERIAL=y
CONFIG_SERIAL_BAUD=250000
CONFIG_RP2040_SERIAL_USART0=y
CONFIG_RP2040_SERIAL_TX_PIN="gpio0"
CONFIG_RP2040_SERIAL_RX_PIN="gpio1"
CONFIG_USB_VENDOR_ID=0x1d50
CONFIG_USB_DEVICE_ID=0x614e
CONFIG_USB_SERIAL_NUMBER_CHIPID=y
CONFIG_WANT_ADC=y
CONFIG_WANT_SPI=n
CONFIG_WANT_I2C=n
CONFIG_WANT_HARD_PWM=y
CONFIG_WANT_NEOPIXEL=y
CONFIG_WANT_BUTTONS=y
CONFIG_INITIAL_PINS=""
CONFIG_HAVE_GPIO=y
CONFIG_HAVE_GPIO_HARD_PWM=y
